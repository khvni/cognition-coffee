# Environment variables. Production values live in the Cloudflare Pages project
# (Settings → Variables and Secrets); see docs/DEPLOY.md.
#
# Local dev:
#   GATSBY_* (client build)  → copy to .env.development (Gatsby loads .env.<NODE_ENV>)
#   everything else (Pages Functions) → copy to .dev.vars (read by `wrangler pages dev`)

# --- Client: PostHog (posthog-js). The public project key is safe to ship in bundles.
GATSBY_POSTHOG_KEY=phc_your_project_key_here
GATSBY_POSTHOG_HOST=https://us.i.posthog.com

# --- Functions: admin page (/admin) and its /api/* endpoints.
# Password for the /admin login; signs the admin_session cookie value.
ADMIN_PASSWORD=change-me
# GitHub token the admin uses to commit content/*.json and uploaded images to main.
# Fine-grained PAT scoped to this repo with Contents: Read and write.
GITHUB_TOKEN=github_pat_your_token_here
# owner/repo the admin commits to.
GITHUB_REPO=khvni/cognition-coffee

# --- Functions: PostHog (posthog-node). Same project key, app host.
# Optional; when unset, admin/content events (admin_logged_in, post_created, ...) are skipped.
POSTHOG_KEY=phc_your_project_key_here
POSTHOG_HOST=https://us.posthog.com
