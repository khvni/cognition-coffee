# PostHog analytics.
# Copy this file to .env and fill in, and add the same vars in the
# Cloudflare Pages project (Settings → Environment variables) for production.
#
# Client-side (posthog-js) — the public project key is safe to ship in bundles.
GATSBY_POSTHOG_KEY=phc_your_project_key_here
GATSBY_POSTHOG_HOST=https://us.i.posthog.com
#
# Server-side (posthog-node in Cloudflare Functions) — same project key, app host.
# Required for admin/content events (admin_logged_in, post_created, etc.).
POSTHOG_KEY=phc_your_project_key_here
POSTHOG_HOST=https://us.posthog.com
